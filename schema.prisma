  id                 String    @id @default(cuid())
  actionType         String
  targetId           String    @default("")
  reason             String    @default("")
  amount             Int?
  requestFingerprint String    @default("")
  requestPayload     Json?
  status             String    @default("pending")
  approvedAt         DateTime?
  consumedAt         DateTime?
  expiresAt          DateTime
  consumedEntityType String    @default("")
  consumedEntityId   String    @default("")
  requestedBy        User?     @relation("ManagerApproval_requestedBy", fields: [requestedById], references: [id])
  requestedById      String?   @map("requestedBy")
  approvedBy         User?     @relation("ManagerApproval_approvedBy", fields: [approvedById], references: [id])
  approvedById       String?   @map("approvedBy")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@index([actionType])
  @@index([targetId])
  @@index([status])
  @@index([expiresAt])
  @@index([requestedById])
  @@index([approvedById])
}

model CashDrawer {
  id                String    @id @default(cuid())
  label             String    @default("")
  status            String    @default("open")
  openKey           String?   @unique
  openingFloatCents Int
  cashSalesCents    Int?      @default(0)
  cashRefundsCents  Int?      @default(0)
  expectedCents     Int?
  countedCents      Int?
  varianceCents     Int?
  varianceReason    String    @default("")
  count             Json?
  openedAt          DateTime
  closedAt          DateTime?
  openedBy          User?     @relation("CashDrawer_openedBy", fields: [openedById], references: [id])
  openedById        String?   @map("openedBy")
  closedBy          User?     @relation("CashDrawer_closedBy", fields: [closedById], references: [id])
  closedById        String?   @map("closedBy")
  currencyCode      String    @default("USD")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([status])
  @@index([openedById])
  @@index([closedById])
}

enum PaymentCollectionDescriptionType {
  default
  refund
}
